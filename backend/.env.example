# DATABASE — no Railway, o plugin Postgres injeta DATABASE_URL automaticamente
DATABASE_URL=postgresql://postgres:senha@localhost:5432/hospitalar360

# SERVER
API_PORT=3001
NODE_ENV=development

# JWT (usado na Parte B — auth real). Gere uma chave longa e aleatória.
JWT_SECRET=troque_por_uma_chave_super_secreta_com_no_minimo_32_caracteres

# CORS — origens permitidas (separadas por vírgula). Em produção, a URL do front.
# 360hospitalar.com.br (raiz + subdomínios) e *.vercel.app já são liberados pelo código.
CORS_ORIGIN=http://localhost:3000

# E-MAIL (confirmação de cadastro) — conta grátis em resend.com
# Sem RESEND_API_KEY, o link de confirmação só é impresso no log (dev local).
RESEND_API_KEY=
EMAIL_FROM=360 Hospitalar <nao-responda@360hospitalar.com.br>

# Base do front — usada para montar o link de confirmação de e-mail.
FRONTEND_URL=http://localhost:3000
